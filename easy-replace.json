{
	"easyReplaceInFiles": [
		{
			"files": "readme.txt",
			"from": "Stable tag:\\s?(.+)",
			"type": "regex",
			"to": "Stable tag: $$npm_package_version$$"
		},
		{
			"files": "$$package__main$$",
			"from": "Version:\\s?(.+)",
			"type": "regex",
			"to": "Version: $$npm_package_version$$"
		},
		{
			"files": "src/block.json",
			"from": "\"version\":\\s\"(.+)\"",
			"type": "regex",
			"to": "\"version\": \"$$npm_package_version$$\""
		},
		{
			"files": "$$package__main$$",
			"from": "define\\( \\'DATE_TODAY_NEPALI_VERSION\\'\\, \\'(.+)\\'",
			"type": "regex",
			"to": "define( 'DATE_TODAY_NEPALI_VERSION', '$$npm_package_version$$'"
		}
	]
}
